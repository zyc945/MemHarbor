{
  "name": "ai-memory-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "test:remote": "node scripts/remote-smoke.mjs",
    "test:worker": "wrangler deploy --dry-run --outdir dist && node scripts/worker-smoke.mjs && node scripts/worker-enhancements.mjs",
    "build:local": "node scripts/build-local.mjs",
    "start:local": "node dist/local/main.mjs",
    "demo": "npm run build:local && node scripts/demo.mjs",
    "check:local": "npm run build:local && node dist/local/main.mjs --check",
    "test:stdio": "npm run build:local && node scripts/stdio-smoke.mjs",
    "evaluate": "node scripts/evaluate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.1",
    "miniflare": "^5.20260918.0-alpha",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "license": "MIT"
}
